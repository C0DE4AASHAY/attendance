# === Next.js Frontend Environment Variables ===

# JWT secret for authentication tokens (any random string, e.g. openssl rand -hex 32)
JWT_SECRET=

# Supabase project credentials (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth Client ID (from Google Cloud Console → Credentials)
# Optional — leave blank to disable Google login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URL of the secure Express backend (Render deployment URL)
# In development: http://localhost:5000
# In production: https://your-backend.onrender.com
NEXT_PUBLIC_SECURE_API_URL=http://localhost:5000
